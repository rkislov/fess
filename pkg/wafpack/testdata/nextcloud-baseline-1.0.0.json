{
  "format": "security-feed-waf-v1",
  "engine": "fess-native-v1",
  "pack_id": "nextcloud-baseline",
  "version": "1.0.0",
  "title": "Nextcloud — базовый профиль",
  "application": "nextcloud",
  "description": "Защита служебных каталогов и CLI. WebDAV, OCS, федерация и загрузка файлов остаются доступны.",
  "license": "Apache-2.0",
  "author": "Security Feed / Роман Сергеевич Кислов",
  "recommended_mode": "log",
  "deployment": "root",
  "coverage": "path-hardening",
  "limitations": [
    "Базовый профиль путей и методов; не является полным OWASP CRS или набором всех CVE-патчей.",
    "Рассчитан на приложение в корне отдельного домена. Для установки в подкаталог нужна адаптация условий.",
    "Перед блокировкой проверьте журнал на рабочем трафике."
  ],
  "references": [
    "https://docs.nextcloud.com/server/stable/admin_manual/installation/nginx.html"
  ],
  "rules": [
    {
      "id": "SF-GEN-001",
      "name": "Закрыть метаданные системы контроля версий",
      "category": "path-hardening",
      "action": "block",
      "priority": 1000,
      "condition": {
        "path_regex": "(?i)^/(?:\\.git|\\.svn|\\.hg)(?:/|$)"
      }
    },
    {
      "id": "SF-GEN-002",
      "name": "Закрыть корневые файлы окружения",
      "category": "path-hardening",
      "action": "block",
      "priority": 1001,
      "condition": {
        "path_regex": "(?i)^/\\.env(?:$|[./_-])"
      }
    },
    {
      "id": "SF-GEN-003",
      "name": "Закрыть зависимости и их lock-файлы",
      "category": "path-hardening",
      "action": "block",
      "priority": 1002,
      "condition": {
        "path_regex": "(?i)^/(?:composer\\.(?:json|lock)|package(?:-lock)?\\.json|yarn\\.lock|pnpm-lock\\.yaml)(?:$|/)"
      }
    },
    {
      "id": "SF-GEN-004",
      "name": "Закрыть приватные ключи в корне сайта",
      "category": "path-hardening",
      "action": "block",
      "priority": 1003,
      "condition": {
        "path_regex": "(?i)^/(?:id_(?:rsa|dsa|ecdsa|ed25519)|\\.ssh)(?:$|[./])"
      }
    },
    {
      "id": "SF-GEN-005",
      "name": "Обнаружить переход к родительскому каталогу",
      "category": "path-hardening",
      "action": "block",
      "priority": 1004,
      "condition": {
        "path_regex": "(?i)(?:^|/)(?:\\.|%2e){2}(?:/|$)"
      }
    },
    {
      "id": "SF-NC-001",
      "name": "Закрыть служебные каталоги Nextcloud",
      "category": "path-hardening",
      "action": "block",
      "priority": 1005,
      "condition": {
        "path_regex": "(?i)^/(?:build|tests|config|lib|3rdparty|templates|data)(?:/|$)"
      }
    },
    {
      "id": "SF-NC-002",
      "name": "Закрыть CLI и описание структуры БД",
      "category": "path-hardening",
      "action": "block",
      "priority": 1006,
      "condition": {
        "path_regex": "(?i)^/(?:occ|console\\.php|db_structure\\.xml)(?:/|$)"
      }
    },
    {
      "id": "SF-NC-003",
      "name": "Закрыть Apache-конфигурацию в корне",
      "category": "path-hardening",
      "action": "block",
      "priority": 1007,
      "condition": {
        "path_regex": "(?i)^/\\.(?:htaccess|htpasswd|user\\.ini)(?:$|/)"
      }
    },
    {
      "id": "SF-GEN-006",
      "name": "Закрыть HTTP TRACE",
      "category": "http-hardening",
      "action": "block",
      "priority": 1108,
      "condition": {
        "method": "TRACE"
      }
    },
    {
      "id": "SF-GEN-007",
      "name": "Закрыть HTTP TRACK",
      "category": "http-hardening",
      "action": "block",
      "priority": 1109,
      "condition": {
        "method": "TRACK"
      }
    }
  ],
  "tests": [
    {
      "method": "GET",
      "path": "/.git/config",
      "match": true
    },
    {
      "method": "GET",
      "path": "/.env.production",
      "match": true
    },
    {
      "method": "GET",
      "path": "/composer.lock",
      "match": true
    },
    {
      "method": "GET",
      "path": "/.ssh/id_rsa",
      "match": true
    },
    {
      "method": "TRACE",
      "path": "/",
      "match": true
    },
    {
      "method": "TRACK",
      "path": "/api",
      "match": true
    },
    {
      "method": "GET",
      "path": "/a/../.env",
      "match": true
    },
    {
      "method": "GET",
      "path": "/%2eenv",
      "match": true
    },
    {
      "method": "GET",
      "path": "/",
      "match": false
    },
    {
      "method": "GET",
      "path": "/.well-known/acme-challenge/token",
      "match": false
    },
    {
      "method": "POST",
      "path": "/api/search?q=UNION+SELECT",
      "match": false
    },
    {
      "method": "GET",
      "path": "/assets/app.js",
      "match": false
    },
    {
      "method": "GET",
      "path": "/config/config.php",
      "match": true
    },
    {
      "method": "GET",
      "path": "/data/user/files/a.txt",
      "match": true
    },
    {
      "method": "GET",
      "path": "/occ",
      "match": true
    },
    {
      "method": "GET",
      "path": "/3rdparty/vendor/file.php",
      "match": true
    },
    {
      "method": "PROPFIND",
      "path": "/remote.php/dav/files/alice/",
      "match": false
    },
    {
      "method": "PUT",
      "path": "/remote.php/dav/files/alice/backup.sql",
      "match": false
    },
    {
      "method": "GET",
      "path": "/remote.php/dav/files/alice/.git/config",
      "match": false
    },
    {
      "method": "MOVE",
      "path": "/remote.php/dav/files/alice/document.txt",
      "match": false
    },
    {
      "method": "REPORT",
      "path": "/remote.php/dav/calendars/alice/default/",
      "match": false
    },
    {
      "method": "POST",
      "path": "/ocs/v2.php/apps/files_sharing/api/v1/shares",
      "match": false
    },
    {
      "method": "POST",
      "path": "/public.php/webdav",
      "match": false
    },
    {
      "method": "GET",
      "path": "/index.php/login",
      "match": false
    },
    {
      "method": "GET",
      "path": "/core/js/oc.js",
      "match": false
    },
    {
      "method": "MKCOL",
      "path": "/remote.php/dav/uploads/alice/chunk-1",
      "match": false
    },
    {
      "method": "GET",
      "path": "/.well-known/carddav",
      "match": false
    }
  ]
}
