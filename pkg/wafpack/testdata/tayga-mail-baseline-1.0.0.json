{
  "format": "security-feed-waf-v1",
  "engine": "fess-native-v1",
  "pack_id": "tayga-mail-baseline",
  "version": "1.0.0",
  "title": "Tayga Mail Server — HTTP-профиль",
  "application": "tayga mail server",
  "description": "Защита HTTP-панели и API: служебные файлы, конфигурация и локальные хранилища. Штатные API и операции приложения сохраняются.",
  "license": "Apache-2.0",
  "author": "Security Feed / Роман Сергеевич Кислов",
  "recommended_mode": "log",
  "deployment": "root",
  "coverage": "path-hardening",
  "limitations": [
    "Базовый профиль путей и методов; не является полным OWASP CRS или набором всех CVE-патчей.",
    "Рассчитан на приложение в корне отдельного домена. Для установки в подкаталог нужна адаптация условий.",
    "Перед блокировкой проверьте журнал на рабочем трафике.",
    "Профиль относится только к HTTP(S). Почтовые, DNS, DHCP и прочие отдельные протоколы этим WAF-набором не фильтруются.",
    "Маршруты сверены с исходниками указанной ревизии; установка приложения за WAF в данном окружении не выполнялась."
  ],
  "references": [
    "https://github.com/rkislov/tayga-mail-server"
  ],
  "rules": [
    {
      "id": "SF-GEN-001",
      "name": "Закрыть метаданные системы контроля версий",
      "category": "path-hardening",
      "action": "block",
      "priority": 1000,
      "condition": {
        "path_regex": "(?i)^/(?:\\.git|\\.svn|\\.hg)(?:/|$)"
      }
    },
    {
      "id": "SF-GEN-002",
      "name": "Закрыть корневые файлы окружения",
      "category": "path-hardening",
      "action": "block",
      "priority": 1001,
      "condition": {
        "path_regex": "(?i)^/\\.env(?:$|[./_-])"
      }
    },
    {
      "id": "SF-GEN-003",
      "name": "Закрыть зависимости и их lock-файлы",
      "category": "path-hardening",
      "action": "block",
      "priority": 1002,
      "condition": {
        "path_regex": "(?i)^/(?:composer\\.(?:json|lock)|package(?:-lock)?\\.json|yarn\\.lock|pnpm-lock\\.yaml)(?:$|/)"
      }
    },
    {
      "id": "SF-GEN-004",
      "name": "Закрыть приватные ключи в корне сайта",
      "category": "path-hardening",
      "action": "block",
      "priority": 1003,
      "condition": {
        "path_regex": "(?i)^/(?:id_(?:rsa|dsa|ecdsa|ed25519)|\\.ssh)(?:$|[./])"
      }
    },
    {
      "id": "SF-GEN-005",
      "name": "Обнаружить переход к родительскому каталогу",
      "category": "path-hardening",
      "action": "block",
      "priority": 1004,
      "condition": {
        "path_regex": "(?i)(?:^|/)(?:\\.|%2e){2}(?:/|$)"
      }
    },
    {
      "id": "SF-GEN-006",
      "name": "Закрыть HTTP TRACE",
      "category": "http-hardening",
      "action": "block",
      "priority": 1105,
      "condition": {
        "method": "TRACE"
      }
    },
    {
      "id": "SF-GEN-007",
      "name": "Закрыть HTTP TRACK",
      "category": "http-hardening",
      "action": "block",
      "priority": 1106,
      "condition": {
        "method": "TRACK"
      }
    },
    {
      "id": "SF-TMS-001",
      "name": "Закрыть bootstrap-конфигурацию Tayga",
      "category": "service-hardening",
      "action": "block",
      "priority": 1207,
      "condition": {
        "path_regex": "(?i)^/(?:config/)?(?:tayga|config)(?:\\.example)?\\.ya?ml(?:$|[./])"
      }
    },
    {
      "id": "SF-TMS-002",
      "name": "Закрыть базу данных почты",
      "category": "service-hardening",
      "action": "block",
      "priority": 1208,
      "condition": {
        "path_regex": "(?i)^/(?:data/)?tayga\\.db(?:$|[.-])"
      }
    },
    {
      "id": "SF-TMS-003",
      "name": "Закрыть сырые почтовые хранилища и DKIM-ключи",
      "category": "service-hardening",
      "action": "block",
      "priority": 1209,
      "condition": {
        "path_regex": "(?i)^/(?:maildir|data/mail|dkim)(?:/|$)"
      }
    }
  ],
  "tests": [
    {
      "method": "GET",
      "path": "/.git/config",
      "match": true
    },
    {
      "method": "GET",
      "path": "/.env.production",
      "match": true
    },
    {
      "method": "GET",
      "path": "/composer.lock",
      "match": true
    },
    {
      "method": "GET",
      "path": "/.ssh/id_rsa",
      "match": true
    },
    {
      "method": "TRACE",
      "path": "/",
      "match": true
    },
    {
      "method": "TRACK",
      "path": "/api",
      "match": true
    },
    {
      "method": "GET",
      "path": "/a/../.env",
      "match": true
    },
    {
      "method": "GET",
      "path": "/%2eenv",
      "match": true
    },
    {
      "method": "GET",
      "path": "/",
      "match": false
    },
    {
      "method": "GET",
      "path": "/.well-known/acme-challenge/token",
      "match": false
    },
    {
      "method": "POST",
      "path": "/api/search?q=UNION+SELECT",
      "match": false
    },
    {
      "method": "GET",
      "path": "/assets/app.js",
      "match": false
    },
    {
      "method": "GET",
      "path": "/data/tayga.db",
      "match": true
    },
    {
      "method": "GET",
      "path": "/config/tayga.yaml",
      "match": true
    },
    {
      "method": "GET",
      "path": "/dkim/example.pem",
      "match": true
    },
    {
      "method": "POST",
      "path": "/api/v1/auth/login",
      "match": false
    },
    {
      "method": "PUT",
      "path": "/api/v1/admin/settings",
      "match": false
    },
    {
      "method": "PROPFIND",
      "path": "/dav/files/alice/",
      "match": false
    },
    {
      "method": "PUT",
      "path": "/dav/shared/team/file.txt",
      "match": false
    },
    {
      "method": "GET",
      "path": "/api/v4/websocket",
      "match": false
    },
    {
      "method": "GET",
      "path": "/.well-known/caldav",
      "match": false
    }
  ],
  "source_revision": "04fd207"
}
