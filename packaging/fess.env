FESS_DATA_DIR=/var/lib/fess
FESS_DB=sqlite
# batch: bounded async queue; sync: database commit before response.
FESS_LOG_MODE=batch
FESS_ADMIN_ADDR=127.0.0.1:8082
WAF_LISTEN_ADDR=:80
WAF_TLS_LISTEN_ADDR=:443
# PostgreSQL: set both after a verified migration.
# FESS_DB=postgres
# FESS_DATABASE_URL=postgres://fess:password@127.0.0.1:5432/fess?sslmode=verify-full
# FESS_ADMIN_PASSWORD is used only to create the first admin account.
# FESS_ADMIN_PASSWORD=choose-a-password

# Optional WAF rule block -> local XDP temporary ban (direct clients only).
# Enable temporary_blocks in Settings -> XDP first. TTL is set by fess-xdp.
# The default socket is detected automatically; set an empty value to disable.
# FESS_XDP_BLOCK_SOCKET=/run/fess-xdp/blocks.sock
# Optional override for the local XDP settings/service controller.
# FESS_XDP_CONTROL_SOCKET=/run/fess-xdp-control/control.sock
