[Unit]
Description=ClamAV signature updates for FESS
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=fess-av
Group=fess-av
ExecStart=/usr/bin/freshclam --config-file=/etc/fess/freshclam.conf --daemon --foreground=true
Restart=on-failure
RestartSec=60
StateDirectory=fess-clamav
StateDirectoryMode=0750
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
